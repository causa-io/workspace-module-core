{
  "name": "@causa/workspace-core",
  "version": "1.1.0",
  "description": "The Causa workspace module providing core function definitions and some implementations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/causa-io/workspace-module-core.git"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./jsonschema": "./dist/jsonschema/index.js",
    "./services": "./dist/services/index.js"
  },
  "files": [
    "dist/",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node transform-schemas.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings=ExperimentalWarning\" jest",
    "test:cov": "npm run test -- --coverage",
    "typecheck": "tsc --noEmit",
    "generateConfigurationSchemas": "cs model genCode && perl -pi -e 's|\\@causa/runtime|\\@causa/workspace/validation|g' src/configurations/generated.ts src/scenarios/generated.ts src/timeline/generated.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.61",
    "@causa/cli": "^1.0.0",
    "@causa/workspace": "^1.0.1",
    "@scalar/json-magic": "^0.12.17",
    "@scalar/openapi-parser": "^0.28.8",
    "ajv": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "expect": "^30.4.1",
    "globby": "^16.2.0",
    "json-e": "^4.8.2",
    "micromatch": "^4.0.8",
    "pino": "^10.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@scalar/openapi-types": "^0.9.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node22": "^22.0.5",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.20.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "nock": "^14.0.16",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
